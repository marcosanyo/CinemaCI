# ==============================================================================
# Cinema CI/CD Environment Configuration Example
# ==============================================================================

# --- Google Cloud & Vertex AI (Gemini & Veo) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_API_KEY=your-gemini-api-key

# Video Generation Model Configuration
GENERATOR_TYPE=veo
VEO_MODEL=veo-3.1-lite-generate-001
VEO_LOCATION=us-central1

# --- Grafana Cloud Observability (OpenTelemetry OTLP) ---
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64-token>

# --- Official Grafana MCP & Datasources ---
GRAFANA_URL=https://your-instance.grafana.net
GRAFANA_SA_TOKEN=your-service-account-token
PROM_DATASOURCE_UID=grafanacloud-prom
LOKI_DATASOURCE_UID=grafanacloud-logs
TEMPO_DATASOURCE_UID=grafanacloud-traces

# --- Strict Mode & Safety ---
STRICT_MODE=true
CINEMA_STRICT_MODE=1
